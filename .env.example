PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
FRONTEND_URL=http://localhost:5173

# Resend Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender email - MUST be a verified domain in Resend (e.g., noreply@yourdomain.com)
# Do NOT use onboarding@resend.dev for production - it only works for the verified account email
EMAIL_FROM=noreply@yourdomain.com

# Recipient email - where contact form submissions are sent
EMAIL_TO=your-email@example.com